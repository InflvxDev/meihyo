# ─── Supabase ───────────────────────────────────────────────────────────────
# Your Supabase project URL. Found in: Project Settings → API → Project URL.
# Required for both SSR and client-side Supabase initialization.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. Found in: Project Settings → API → Project API keys.
# Safe to expose on the client — access is enforced by Row Level Security (RLS) policies.
# Never use the service-role key here; it bypasses RLS entirely.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here