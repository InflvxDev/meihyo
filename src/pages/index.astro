---
import Layout from "../layouts/Layout.astro";
import GameSelector from "../components/home/GameSelector";
import LandingNavbar from "../components/home/LandingNavbar.astro";
import BentoGrid from "../components/home/BentoGrid.astro";
import FeatureSections from "../components/home/FeatureSections.astro";
import CTASection from "../components/home/CTASection.astro";
import LandingFooter from "../components/home/LandingFooter.astro";
---

<Layout>
  <div class="min-h-screen bg-background text-foreground">
    <LandingNavbar />

    <main
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-6 py-8 sm:py-12 flex flex-col items-center justify-center pt-12"
    >
      <div class="text-center space-y-4 w-full">
        <h1
          class="text-foreground text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-sans font-medium tracking-wide"
        >
          Construye un camino <br /> para tus logros
        </h1>
        <h2
          class="text-primary text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-sans font-semibold tracking-wide"
        >
          Mejora tu juego
        </h2>
        <p
          class="font-sans text-secondary text-base md:text-xl font-medium leading-relaxed max-w-2xl mx-auto mt-14"
        >
          Meihyo es una plataforma de seguimiento de entrenamientos y partidas
          competitivas. Consolida sesiones, analiza metas y alcanza tu mejor
          versión.
        </p>

        <div class="flex flex-row gap-4 justify-center mt-12">
          <a
            href="/signup"
            class="bg-primary/60 text-foreground px-6 py-2 rounded-lg text-sm font-semibold hover:brightness-125 transition-all border border-primary"
            >Comienza tu viaje</a
          >
          <a
            href="/demo"
            class="bg-secondary/60 text-foreground px-6 py-2 rounded-lg text-sm font-semibold hover:brightness-125 transition-all border border-secondary"
            >Ver Demo</a
          >
        </div>

        <BentoGrid />
      </div>
    </main>

    <GameSelector client:load />

    <FeatureSections />
    <CTASection />
    <LandingFooter />
  </div>
</Layout>
