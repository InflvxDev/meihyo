---
import Layout from "./Layout.astro";
import UserMenu from "../components/shared/navbar/UserMenu";
import GamesSidebar from "../components/shared/sidebar/GamesSidebar";

interface Props {
  title?: string;
  route?: string;
}

const { title, route } = Astro.props;
const { user } = Astro.locals;
---

<Layout title={title}>
  <div class="min-h-screen bg-background text-foreground">
    <!--
      Static navbar shell — rendered as plain HTML; no JavaScript shipped for this structure.
      Only UserMenu (interactive dropdown island) is hydrated with client:load.
    -->
    <nav class="relative bg-background border-b border-foreground/10">
      <div class="flex items-center justify-between w-full px-0 py-0">
        <div class="flex items-center gap-2">
          <a
            href="/dashboard"
            class="flex items-center gap-1.5 hover:opacity-80 transition-opacity"
          >
            <img
              src="/favicon.webp"
              alt="Meihyo"
              class="w-8 h-8 sm:w-10 sm:h-10 lg:w-12 lg:h-12"
            />
          </a>
          <span class="hidden sm:inline text-foreground/40 text-xl">/</span>
          {route && (
            <span class="hidden sm:inline text-foreground text-xs sm:text-sm md:text-sm truncate font-bold max-w-70 pl-2">
              {route}
            </span>
          )}
        </div>

        <div class="flex items-center justify-end pr-2">
          <UserMenu client:load userEmail={user?.email ?? ""} />
        </div>
      </div>
    </nav>

    <!-- GamesSidebar hydrated separately for its hover expand/collapse state -->
    <GamesSidebar client:load />

    <main class="pl-20">
      <slot />
    </main>
  </div>
</Layout>
